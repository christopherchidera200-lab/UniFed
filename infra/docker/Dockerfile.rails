# UniFed Rails backend - production image
# Multi-stage, slim, non-root, tuned for Rails 7 + Puma + Bootsnap.
FROM ruby:3.3-slim AS base

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    LANG=C.UTF-8

# Minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpq5 libvips libjemalloc2 ca-certificates curl \
      && rm -rf /var/lib/apt/lists/*

# ---- Builder ----
FROM base AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libpq-dev pkg-config git \
      && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

COPY . .
RUN SECRET_KEY_BASE=dummy RAILS_ENV=production bundle exec rails assets:precompile || true

# ---- Runtime ----
FROM base AS runtime

# jemalloc for lower memory footprint / fragmentation
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2 \
    RAILS_SERVE_STATIC_FILES=true \
    RAILS_LOG_TO_STDOUT=true

WORKDIR /app
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app

# Non-root
RUN groupadd --system unifed && useradd --system --gid unifed --home /app unifed \
    && chown -R unifed:unifed /app /usr/local/bundle
USER unifed

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:3000/healthz || exit 1

CMD ["bundle","exec","puma","-C","config/puma.rb"]
