# UniFed Nigeria — STAGING environment template (Coolify)
# Copy to your Coolify project env and REPLACE every <PLACEHOLDER> with a real,
# staging-isolated secret. DO NOT commit real values. DO NOT reuse production
# credentials. Secrets are managed in Coolify, not in Git.

# ---- Runtime ----
RAILS_ENV=production
RACK_ENV=production
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true
PORT=3000

# ---- PostgreSQL (Coolify-managed or your staging DB; internal network, no TLS) ----
DATABASE_HOST=postgres
DATABASE_USER=unifed
DATABASE_PASSWORD=<STAGING_DB_PASSWORD>
DATABASE_NAME=unifed
DATABASE_URL=postgres://unifed:<STAGING_DB_PASSWORD>@postgres:5432/unifed
DATABASE_SSL=false

# ---- Redis (rate limiting + observability; inline cache, no separate worker) ----
REDIS_URL=redis://redis:6379/0

# ---- Rails secret + OIDC signing key (RS256 JWKS) ----
# Generate: openssl genrsa -out staging.pem 2048  (keep the private key in Coolify only)
SECRET_KEY_BASE=<64_HEX_CHARS_FROM_rails_secret>
OIDC_JWKS_PRIVATE=<PEM_OR_BASE64_PEM_PRIVATE_KEY>
OIDC_KID=unifed-staging-1
OIDC_ISSUER=https://api-staging.<your-domain>
# Dedicated HS256 secret for internal API tokens (Identity::TokenService).
# MUST be a DIFFERENT value from OIDC_JWKS_PRIVATE. Reusing the RSA signing key
# would let the published RS256 public key double as this HMAC secret and enable
# JWT algorithm-confusion token forgery (vuln-0004). Generate a random 32+ byte
# string, e.g. `openssl rand -hex 32`.
TOKEN_SERVICE_SECRET=<DISTINCT_RANDOM_HS256_SECRET_32PLUS_BYTES>

# ---- Node identity (this staging instance) ----
NODE_SLUG=adun-staging
# UUID of the seeded staging university (see db/seeds.rb -> adun node).
NODE_UNIVERSITY_ID=<STAGING_UNIVERSITY_UUID>

# ---- Federation (ActivityPub) ----
FEDERATION_ENABLED=true

# ---- Next.js frontend ----
# Public API URL the browser uses. MUST be the staging API domain (NEXT_PUBLIC is
# baked at build time). Set as a Coolify build arg + runtime env on the frontend.
NEXT_PUBLIC_API_BASE=https://api-staging.<your-domain>

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=120

# ---- Security headers ----
SECURE_HEADERS_HSTS=true

# ---- Observability (optional; leave blank if no OTLP collector) ----
OTEL_SERVICE_NAME=unifed-staging
OTEL_EXPORTER_OTLP_ENDPOINT=

# NOTE: force_ssl is enabled in config/environments/production.rb. Coolify
# terminates TLS and forwards X-Forwarded-Proto, so HTTPS works end-to-end.
# Set RAILS_FORCE_SSL=false only if your proxy does not forward the proto header.
