{
  "components": {
    "schemas": {
      "CollectorResult": {
        "properties": {
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          },
          "collector": {
            "title": "Collector",
            "type": "string"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/CollectorStatus"
          }
        },
        "required": [
          "collector",
          "status",
          "duration_ms"
        ],
        "title": "CollectorResult",
        "type": "object"
      },
      "CollectorStatus": {
        "enum": [
          "ok",
          "empty",
          "timeout",
          "error",
          "skipped"
        ],
        "title": "CollectorStatus",
        "type": "string"
      },
      "Finding": {
        "description": "One atomic, attributable fact discovered about a target.",
        "properties": {
          "collector": {
            "title": "Collector",
            "type": "string"
          },
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "legal_basis": {
            "description": "Why collecting this is lawful",
            "title": "Legal Basis",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "info"
          },
          "source": {
            "description": "Human-readable provenance, e.g. 'DNS (authoritative)'",
            "title": "Source",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "collector",
          "title",
          "source",
          "legal_basis"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "collectors": {
            "items": {
              "type": "string"
            },
            "title": "Collectors",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "version",
          "collectors"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InvestigationRequest": {
        "properties": {
          "collectors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Subset of collectors to run. None = all applicable.",
            "title": "Collectors"
          },
          "target": {
            "maxLength": 253,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "target_type": {
            "$ref": "#/components/schemas/TargetType",
            "default": "domain"
          }
        },
        "required": [
          "target"
        ],
        "title": "InvestigationRequest",
        "type": "object"
      },
      "InvestigationResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "integer"
          },
          "findings_count": {
            "title": "Findings Count",
            "type": "integer"
          },
          "investigation_id": {
            "title": "Investigation Id",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/CollectorResult"
            },
            "title": "Results",
            "type": "array"
          },
          "risk": {
            "$ref": "#/components/schemas/RiskScore"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "target_type": {
            "$ref": "#/components/schemas/TargetType"
          }
        },
        "required": [
          "investigation_id",
          "target",
          "target_type",
          "created_at",
          "duration_ms",
          "results",
          "risk",
          "findings_count"
        ],
        "title": "InvestigationResponse",
        "type": "object"
      },
      "InvestigationSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "findings_count": {
            "title": "Findings Count",
            "type": "integer"
          },
          "investigation_id": {
            "title": "Investigation Id",
            "type": "string"
          },
          "risk_score": {
            "title": "Risk Score",
            "type": "integer"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "target_type": {
            "$ref": "#/components/schemas/TargetType"
          }
        },
        "required": [
          "investigation_id",
          "target",
          "target_type",
          "created_at",
          "risk_score",
          "findings_count"
        ],
        "title": "InvestigationSummary",
        "type": "object"
      },
      "RiskScore": {
        "properties": {
          "band": {
            "enum": [
              "low",
              "moderate",
              "elevated",
              "high"
            ],
            "title": "Band",
            "type": "string"
          },
          "rationale": {
            "items": {
              "type": "string"
            },
            "title": "Rationale",
            "type": "array"
          },
          "score": {
            "description": "0 = no signal, 100 = maximum concern",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          }
        },
        "required": [
          "score",
          "band",
          "rationale"
        ],
        "title": "RiskScore",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "info",
          "low",
          "medium",
          "high"
        ],
        "title": "Severity",
        "type": "string"
      },
      "TargetType": {
        "enum": [
          "domain",
          "ip",
          "email",
          "username"
        ],
        "title": "TargetType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Legal OSINT aggregation. Public sources and authorized APIs only \u2014 see docs/LEGAL_AND_ETHICS.md.",
    "title": "CloudIntel API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/collectors": {
      "get": {
        "description": "Expose the source catalogue, including the legal basis for each source.",
        "operationId": "list_collectors_collectors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Collectors Collectors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Collectors",
        "tags": [
          "system"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/investigations": {
      "get": {
        "operationId": "list_investigations_investigations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InvestigationSummary"
                  },
                  "title": "Response List Investigations Investigations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Investigations",
        "tags": [
          "investigations"
        ]
      },
      "post": {
        "operationId": "create_investigation_investigations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Investigation",
        "tags": [
          "investigations"
        ]
      }
    },
    "/investigations/{investigation_id}": {
      "get": {
        "operationId": "get_investigation_investigations__investigation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "investigation_id",
            "required": true,
            "schema": {
              "title": "Investigation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Investigation",
        "tags": [
          "investigations"
        ]
      }
    }
  }
}