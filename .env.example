# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Required as of the security-hardening pass (fail-closed JWT secret check).
# Generate a strong random value, e.g.: openssl rand -hex 64
# Must NOT be empty or match any of: dev-insecure-change-me,
# ci-insecure-not-for-prod, change-me-in-prod (these are explicitly rejected).
OIDC_JWKS_PRIVATE=

# Dedicated HS256 secret for internal API tokens (Identity::TokenService).
# MUST be DISTINCT from OIDC_JWKS_PRIVATE. Reusing the RSA signing key would let
# the published RS256 public key double as this HMAC secret and enable JWT
# algorithm-confusion token forgery (vuln-0004). Generate a random 32+ byte
# string, e.g. `openssl rand -hex 32`. In dev/test this falls back to
# OIDC_JWKS_PRIVATE if unset, but PRODUCTION must set it.
TOKEN_SERVICE_SECRET=
