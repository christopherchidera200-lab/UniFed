# ============================================================
# UniFed Nigeria — monorepo ignores
# ============================================================

# Ruby / Rails
backend/.bundle/
backend/vendor/bundle
backend/log/*.log
backend/tmp/
backend/coverage/
backend/public/assets
backend/.ruby-version
*.gem

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/coverage/
frontend/.env*.local
frontend/*.tsbuildinfo
npm-debug.log*

# Env / secrets — NEVER commit credentials
.env
.env.*
*.pem
*.key
secrets/
backend/config/credentials/*.yml.enc.key

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/.terraform.lock.hcl
infra/terraform/tfplan
infra/terraform/ci.tfbackend

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs / temp
*.log
tmp/

# CI log scratch files
_job*.log
_t.log
_test_job.log
